import { test, expect } from '@playwright/test';
import {
  connectToObsidian,
  handleTrustDialog,
  createFreshNote,
  switchToReadingMode,
  switchToEditingMode,
  getActiveEditor,
  getActiveReadingView,
  typeInEditor,
  ObsidianConnection
} from './helpers';

let obsidian: ObsidianConnection;

test.describe('Editor Interaction Tests', () => {
  test.beforeAll(async () => {
    obsidian = await connectToObsidian();
    await handleTrustDialog(obsidian.page);
  });

  test.afterAll(async () => {
    await obsidian.browser.close();
  });

  // TEMPLATE: Copy this test and modify for your use case
  test('example: multiple math expressions in one note', async () => {
    const { page } = obsidian;

    // Create a fresh note
    const editor = await createFreshNote(page);

    // Type some content with multiple expressions
    await typeInEditor(page, 'First: `!x=3m`');
    await page.keyboard.press('Enter');
    await typeInEditor(page, 'Second: `!y=5kg`');

    // Switch to reading mode and verify
    await switchToReadingMode(page);
    const readingView = await getActiveReadingView(page);

    // Check for rendered content
    const content = await readingView.textContent();
    expect(content).toContain('3 m');
    expect(content).toContain('5 kg');

    console.log('✓ Multiple expressions rendered');
  });

